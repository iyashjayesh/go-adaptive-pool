        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind, status) (rate(adaptivepool_jobs_completed_total{pool=~\"$pool\",status!=\"success\"}[1m]))",
